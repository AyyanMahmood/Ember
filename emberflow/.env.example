# EmberFlow environment variables.
#
# Frontend (VITE_*) variables are read by Vite and go in frontend/.env.local
# for local development. Backend variables (no VITE_ prefix) are read by the
# api/ serverless functions and are configured in your Vercel project's
# Environment Variables settings for deployed environments — they are never
# bundled into the browser build.

# ── Supabase — frontend (required) ──────────────────────────────────────────
# Project URL and anon/public key from Supabase Dashboard > Project Settings
# > API. The app throws on startup if either is missing.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── App URL — frontend (optional, recommended for production) ──────────────
# Base URL used to build OAuth/email redirect links and canonical/OG tags.
# If unset, the app falls back to window.location.origin, which works for
# local development but can vary across preview/alias domains in production —
# set this explicitly once you know your production domain.
VITE_APP_URL=http://localhost:5173

# ── App URL — backend (required in production) ──────────────────────────────
# Used by api/_utils/http.js to set the CORS allow-origin header on API
# responses. If unset in production, the API omits the CORS header entirely
# (fails closed) rather than allowing all origins — set this to your actual
# deployed frontend URL.
APP_URL=http://localhost:5173

# ── Supabase — backend (required) ───────────────────────────────────────────
# Same project URL as above, plus the service role key from Supabase
# Dashboard > Project Settings > API. The service role key bypasses row-level
# security — it is used only in api/ serverless functions, never sent to the
# browser, and must be kept secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Polar — backend (required only if you enable Pro subscription billing) ──
# Core app functionality (auth, clients, invoices, proposals, PDF export)
# works without these. They're only needed for the /api/polar/* checkout,
# billing-portal, and webhook routes and the Pro upgrade flow in Settings.
# Polar is a Merchant of Record: it hosts checkout, remits sales tax/VAT, and
# runs the customer billing portal — EmberFlow never touches card data.
#
# POLAR_SERVER selects the environment: "sandbox" for testing against
# sandbox.polar.sh, "production" for live billing against polar.sh.
POLAR_SERVER=sandbox
# Organization Access Token — Polar Dashboard > Settings > Developers.
# Server-side only; never bundled into the browser build. Keep it secret.
POLAR_ACCESS_TOKEN=polar_oat_your_access_token
# Webhook signing secret — Polar Dashboard > Settings > Webhooks > (endpoint).
# Used to verify every /api/polar/webhook delivery (Standard Webhooks HMAC).
POLAR_WEBHOOK_SECRET=your-polar-webhook-secret
# Pro plan PRODUCT ids — Polar Dashboard > Products > "..." > Copy Product ID.
# Note: Polar checkout is created from product ids, not price ids.
POLAR_PRODUCT_PRO_MONTHLY=your-pro-monthly-product-id
POLAR_PRODUCT_PRO_YEARLY=your-pro-yearly-product-id

# ── Upstash Redis — backend (required) ──────────────────────────────────────
# REST URL and token from your Upstash Redis database, used by
# api/_utils/rateLimit.js to rate-limit the api/polar/* routes. Create a
# free database at upstash.com to get these.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
